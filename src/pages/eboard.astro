---
import Layout from "@layouts/Layout.astro";
import Heading from "@components/Heading.astro";
import Member from "@components/Eboard/Member.astro";
import EBoardSection from "@components/Eboard/EBoardSection.astro";
import { getCollection } from "astro:content";

type Role = {
  role: string;
  yearsActive: string;
};

function posComparefn(
  a: { data: { position: number } },
  b: { data: { position: number } },
): number {
  return a.data.position - b.data.position;
}

function latestYear(roles: Role[]): number | null {
  const role = roles[0];
  if (role == null) return null;

  const year = role.yearsActive.split("-")[1];
  if (year == null) return null;

  return Number(year);
}

const eBoard = (await getCollection("eBoard")).toSorted(posComparefn);

const formerEBoard = (await getCollection("formerEBoard")).toSorted((a, b) => {
  const memberA = latestYear(a.data.roles);
  const memberB = latestYear(b.data.roles);

  if (memberA != null && memberB != null) {
    return memberB - memberA;
  } else return -1;
});

const founders = (await getCollection("founders")).toSorted(posComparefn);
---

<Layout>
  <Heading title="E-BOARD" barcode="E-BOARD" />
  <EBoardSection title="CURRENT">
    {eBoard.map((member) => <Member member={member} />)}
  </EBoardSection>

  <EBoardSection title="FORMER">
    {formerEBoard.map((member) => <Member member={member} />)}
  </EBoardSection>

  <EBoardSection title="FOUNDERS">
    {founders.map((member) => <Member member={member} />)}
  </EBoardSection>
</Layout>
