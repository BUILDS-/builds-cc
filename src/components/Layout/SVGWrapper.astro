<div class="svg-wrapper" data-js="outer-frame" style="opacity: 1;">
  <!-- svg should have z-index lower than logo -->
  <svg fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <mask id="mask">
        <rect id="outer-mask-bg" x="0" y="0" fill="white"></rect>
        <rect id="inner-mask-body" class="rect-radius" fill="black"></rect>
      </mask>
    </defs>
    <rect
      id="outer-rect-bg"
      class="rect-bg"
      x="0"
      y="0"
      fill="var(--color-bg)"
      mask="url(#mask)"></rect>
    <rect
      id="inner-rect-border"
      class="rect-radius"
      stroke-width="1"
      stroke="var(--color-border)"
      vector-effect="non-scaling-stroke"></rect>
  </svg>
</div>
<script>
  import { assertExist } from "@lib/fp";
  import isMobile from "@scripts/isMobile";
  import { frameMorphParams } from "@lib/layout/navAnimations";
  import { calcFrame } from "@lib/layout/SVGGeometry";
  import { animate } from "animejs";

  // SVG related code below

  const $svgFrame = document.querySelector('[data-js="outer-frame"] svg');
  const outerRects = document.querySelectorAll(
    "#outer-mask-bg, #outer-rect-bg",
  );
  const innerRects = document.querySelectorAll(
    "#inner-mask-body, #inner-rect-border",
  );

  function updateFrame() {
    const vh = document.documentElement.clientHeight;
    const vw = document.documentElement.clientWidth;
    // console.log(`width: ${vw}`);
    // console.log(`height: ${vh}`);

    assertExist($svgFrame, "$svgFrame does not exist");
    $svgFrame.setAttribute("width", `${vw}`);
    $svgFrame.setAttribute("height", `${vh}`);
    $svgFrame.setAttribute("viewBox", `0 0 ${vw} ${vh}`);

    const mobile = isMobile();
    const { outer, inner } = calcFrame(vw, vh, mobile);

    outerRects.forEach((r) => {
      r.setAttribute("width", `${outer.width}`);
      r.setAttribute("height", `${outer.height}`);
    });

    // Mobile check, based on logo's media query
    innerRects.forEach((r) => {
      r.setAttribute("x", `${inner.x}`);
      r.setAttribute("y", `${inner.y}`);
      r.setAttribute("width", `${inner.width}`);
      r.setAttribute("height", `${inner.height}`);
    });
  }

  updateFrame(); // Initial call to draw SVG
  window.addEventListener("resize", updateFrame);

  document.addEventListener("navOpen", () => {
    animate(innerRects, frameMorphParams("open"));
  });

  document.addEventListener("navClose", () => {
    animate(innerRects, frameMorphParams("close"));
  });
</script>
<style>
  .svg-wrapper {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: var(--z-svg);
  }

  .svg-wrapper svg {
    display: block;
  }

  .svg-wrapper rect {
    transform-origin: center;
  }
</style>
