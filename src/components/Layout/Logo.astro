---
import BuildsSVG from "@assets/BUILDS-Cropped.svg";
---

<header id="logo-container">
  <a href="/" aria-label="Builds home page">
    <BuildsSVG width="315" height="78" />
  </a>
</header>

<script>
  import { navSlideParams } from "@lib/layout/navAnimations";
  import { closeNav } from "@scripts/navState";
  import { animate } from "animejs";

  const $header = document.querySelector("header");
  $header?.addEventListener("click", closeNav);

  document.addEventListener("navOpen", () => {
    animate(`#logo-container`, navSlideParams("open"));
  });

  document.addEventListener("navClose", () => {
    animate(`#logo-container`, navSlideParams("close"));
  });
</script>
<style>
  a {
    display: block;
  }

  #logo-container {
    position: fixed;
    top: 8px;
    left: 50%;
    transform: translatex(-50%);

    width: fit-content;
    height: 50px;

    white-space: nowrap;
    text-align: center;
    background-color: var(--color-bg);
    z-index: var(--z-logo);

    svg {
      width: 200px;
      height: 50px;
    }
  }

  @media (min-width: 800px) {
    #logo-container {
      top: 18px;
      left: 40px;
      transform: none;
      height: 87px;

      svg {
        width: 350px;
        height: 87px;
      }
    }
  }
</style>
