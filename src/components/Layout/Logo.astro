---
import fl from "figlet";
import AnsiShadow from "figlet/fonts/ANSI Shadow";
fl.parseFont("AnsiShadow", AnsiShadow); // load font
const BU = fl.textSync("BU", { font: "AnsiShadow" }).trim();
const ILDS = fl.textSync("ILDS", { font: "AnsiShadow" }).trim();
---

<header id="logo-container">
  <a href="/" aria-label="Builds home page">
    <pre class="logo-accent">{BU}</pre>
    <pre>{ILDS}</pre>
  </a>
</header>

<script>
  import { NAV_DURATION, NAV_EASE, NAV_SLIDE_DIST } from "@lib/constants";
  import { closeNav } from "@lib/navState";
  import { animate } from "animejs";

  const $header = document.querySelector("header");
  $header?.addEventListener("click", closeNav);

  document.addEventListener("navOpen", () => {
    animate(`#logo-container`, {
      duration: NAV_DURATION,
      ease: NAV_EASE,
      top: `+=${NAV_SLIDE_DIST}`,
    });
  });

  document.addEventListener("navClose", () => {
    animate(`#logo-container`, {
      duration: NAV_DURATION,
      ease: NAV_EASE,
      top: `-=${NAV_SLIDE_DIST}`,
    });
  });
</script>
<style>
  a {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  #logo-container {
    position: fixed;
    top: 8px;
    left: 50%;
    transform: translatex(-50%);
    width: fit-content;
    white-space: nowrap;
    text-align: center;
    background-color: var(--color-bg);
    height: 44px;
    z-index: var(--z-logo);
  }

  #logo-container pre {
    font-family: "Courier New", monospace;
    font-size: 8px;
    line-height: 1;
    display: inline-block;
    margin: 0;
    padding: 0;
    color: var(--color-text);
  }

  #logo-container .logo-accent {
    color: var(--color-accent);
  }

  @media (min-width: 800px) {
    #logo-container {
      top: 18px;
      left: 40px;
      transform: none;
      height: 85px;
    }
    #logo-container pre {
      font-size: 15px;
    }
  }
</style>
