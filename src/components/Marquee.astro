---
interface Props {
  speed: number;
  content: string[];
}
const { speed = 20, content = [] } = Astro.props;
---

<marquee-slide class="marquee" data-speed={speed}>
  <div class="marquee-content">
    {content.map((quote) => <p class="marquee-text">{quote}</p>)}
  </div>
</marquee-slide>

<script>
  import { animate, type JSAnimation, linear, utils } from "animejs";
  const start = Date.now();

  class MarqueeSlide extends HTMLElement {
    #animation: JSAnimation | null = null;
    #allQuotesEl: HTMLParagraphElement[] = [];
    #SPEED = 0;
    #GAP = 0;

    constructor() {
      super();
      this.addEventListener("mouseenter", this.pauseAnimation);
      this.addEventListener("mouseleave", this.resumeAnimation);
    }

    copyCount() {
      let strideWidth = 0;
      this.#allQuotesEl.forEach(($elm: HTMLParagraphElement) => {
        strideWidth += $elm.getBoundingClientRect().width + this.#GAP;
      });
      console.log(strideWidth);
      return Math.ceil((window.innerWidth * 2) / strideWidth) + 1;
    }

    animateElm($elm: Element) {
      // Is a recursive call really a good decision?
      // Maybe consider CSS only
      return animate($elm, {
        x: `-= ${$elm.getBoundingClientRect().width * 2}`,
        ease: linear(0, 1),
        duration: 10000,
        loop: true,
        modifier: utils.wrap(-$elm.getBoundingClientRect().width, 0),
        // onComplete: () => {
        //   const ms = Date.now() - start;
        //   console.log(ms / 1000);
        //   console.log($elm.getBoundingClientRect().x);
        //   this.#animation = this.animateElm($elm);
        // },
      });
    }

    pauseAnimation() {
      throw new Error("Not yet implemented");
    }

    resumeAnimation() {
      throw new Error("Not yet implemented");
    }

    connectedCallback() {
      this.#SPEED = Number(this.dataset.speed ?? 20);

      const $el = this.querySelector(".marquee-content");
      if ($el != null) {
      } else {
        throw new Error(".marquee-content does not exist");
      }
    }

    disconnectedCallback() {
      if (this.#animation != null) this.#animation.reset();
    }
  }

  customElements.define("marquee-slide", MarqueeSlide);
</script>

<style>
  marquee-slide {
    overflow: hidden;
    width: 100%;
    height: 60px;
    border-bottom: solid 1px var(--color-border);
    display: flex;
  }

  .marquee-content {
    display: flex;
    justify-content: start;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding-left: 20px;

    & :global(.marquee-text) {
      white-space: nowrap;
    }
  }
</style>
