---
interface Props {
  speed: number;
  gap: number;
}
const { speed, gap } = Astro.props;

// TODO:: Needs to be refactored
// Should take in an array of quotes and render content with forEach
//
// Have static component content for up-coming and on-going state only, instead
// of declaring quotes inside marquee.
---

<marquee-slide class="marquee" data-speed={speed} data-gap={gap}>
  <div class="marquee-content"></div>
</marquee-slide>

<script>
  import { animate, type JSAnimation, linear } from "animejs";

  const quotes = [
    "lorem ipsum",
    "Some random quote",
    "I DON'T GIVE A SHIT ABOUT VILTRUM",
    "I'm reaching out about your extended cars warranty",
    "Batman, I -I caught uh I caught a little Pokemon",
  ];
  const allQuotesEl: HTMLParagraphElement[] = [];

  class MarqueeSlide extends HTMLElement {
    #animation: JSAnimation | null = null;
    #SPEED = 0;
    #GAP = 0;

    constructor() {
      super();
      this.addEventListener("mouseenter", this.pauseAnimation);
      this.addEventListener("mouseleave", this.resumeAnimation);
    }

    renderInitialText() {
      const $contentEl = this.querySelector(".marquee-content");
      if ($contentEl == null) throw new Error("contentEl does not exist");
      $contentEl.innerHTML = "";

      quotes.forEach((quote) => {
        const $quoteEl = document.createElement("p");
        $quoteEl.classList.add("marquee-text");
        $quoteEl.innerText = quote;
        $contentEl.appendChild($quoteEl);
        allQuotesEl.push($quoteEl);
      });

      return $contentEl;
    }

    copyCount() {
      let strideWidth = 0;
      allQuotesEl.forEach(($elm: HTMLParagraphElement) => {
        strideWidth += $elm.getBoundingClientRect().width + this.#GAP;
      });
      console.log(strideWidth);
      return Math.ceil((window.innerWidth * 2) / strideWidth);
    }

    animateElm($elm: Element) {
      return animate($elm, {
        x: `-= ${this.#SPEED}`,
        ease: linear(0, 1),
        onComplete: () => {
          this.#animation = this.animateElm($elm);
        },
      });
    }

    pauseAnimation() {
      if (this.#animation != null) this.#animation.pause();
      console.log("pause");
    }

    resumeAnimation() {
      console.log("resume");
      if (this.#animation != null) this.#animation.resume();
    }

    connectedCallback() {
      this.#SPEED = Number(this.dataset.speed ?? 20);
      this.#GAP = Number(this.dataset.gap ?? 20);

      const $el = this.renderInitialText();
      if ($el) this.#animation = this.animateElm($el);
      // let count = copyCount() - 1;
      // while (count > 0) {
      //   renderInitialText();
      //   count--;
      // }
    }

    disconnectedCallback() {
      if (this.#animation != null) this.#animation.reset();
    }
  }

  customElements.define("marquee-slide", MarqueeSlide);
</script>

<style>
  marquee-slide {
    overflow: hidden;
    width: 100%;
    height: 60px;
    border-bottom: solid 1px var(--color-border);
    display: flex;
  }

  .marquee-content {
    display: flex;
    justify-content: start;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding-left: 20px;

    & :global(.marquee-text) {
      white-space: nowrap;
    }
  }
</style>
