---
interface Props {
  speed: number;
  gap: number;
  content: string[];
}
const { speed = 20, gap = 20, content = [""] } = Astro.props;
console.log("hi");

// TODO:: Needs to be refactored
// Should take in an array of quotes and render content with forEach
//
// Have static component content for up-coming and on-going state only, instead
// of declaring quotes inside marquee.
---

<marquee-slide class="marquee" data-speed={speed} data-gap={gap}>
  <div class="marquee-content">
    {content.map((quote) => <p class="marquee-text">{quote}</p>)}
  </div>
</marquee-slide>

<script>
  import { animate, type JSAnimation, linear } from "animejs";

  class MarqueeSlide extends HTMLElement {
    #animation: JSAnimation | null = null;
    #allQuotesEl: HTMLParagraphElement[] = [];
    #SPEED = 0;
    #GAP = 0;

    constructor() {
      super();
      this.addEventListener("mouseenter", this.pauseAnimation);
      this.addEventListener("mouseleave", this.resumeAnimation);
    }

    copyCount() {
      let strideWidth = 0;
      this.#allQuotesEl.forEach(($elm: HTMLParagraphElement) => {
        strideWidth += $elm.getBoundingClientRect().width + this.#GAP;
      });
      console.log(strideWidth);
      return Math.ceil((window.innerWidth * 2) / strideWidth);
    }

    animateElm($elm: Element) {
      return animate($elm, {
        x: `-= ${this.#SPEED}`,
        ease: linear(0, 1),
        onComplete: () => {
          this.#animation = this.animateElm($elm);
        },
      });
    }

    pauseAnimation() {
      if (this.#animation != null) this.#animation.pause();
      console.log("pause");
    }

    resumeAnimation() {
      console.log("resume");
      if (this.#animation != null) this.#animation.resume();
    }

    connectedCallback() {
      this.#SPEED = Number(this.dataset.speed ?? 20);
      this.#GAP = Number(this.dataset.gap ?? 20);

      const $el = this.querySelector(".marquee-content");
      if ($el != null) {
        this.#animation = this.animateElm($el);
        for (const child of $el.children) {
          if (child instanceof HTMLParagraphElement) {
            // I will likely regret this approach later but it works for now
            this.#allQuotesEl.push(child as HTMLParagraphElement);
          }
        }
      } else {
        throw new Error(".marquee-content does not exist");
      }

      // let count = copyCount() - 1;
      // while (count > 0) {
      //   renderInitialText();
      //   count--;
      // }
    }

    disconnectedCallback() {
      if (this.#animation != null) this.#animation.reset();
    }
  }

  customElements.define("marquee-slide", MarqueeSlide);
</script>

<style>
  marquee-slide {
    overflow: hidden;
    width: 100%;
    height: 60px;
    border-bottom: solid 1px var(--color-border);
    display: flex;
  }

  .marquee-content {
    display: flex;
    justify-content: start;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding-left: 20px;

    & :global(.marquee-text) {
      white-space: nowrap;
    }
  }
</style>
