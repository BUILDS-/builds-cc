---
interface Props {
  title: string;
  barcode: string;
  border?: boolean;
  /** Animation delay before the cursor starts blinking (e.g. "1s", "600ms"). */
  delay?: string;
}

const { title, barcode, border = true, delay = "1s" } = Astro.props;
---

<section class="heading" class:list={[{ bordered: border }]}>
  <h1>{title}</h1>
  <h2 class="header-barcode">{barcode}</h2>
  <slot />
</section>

<style define:vars={{ delay }}>
  .heading {
    padding: 60px var(--mobile-padding-inner) 20px var(--mobile-padding-inner);

    h1 {
      font-size: 2.2rem;
    }

    span {
      color: var(--color-accent);
    }

    h1::after {
      margin-left: 8px;
      content: "\00258c";
      font-size: 1.4rem;
    }

    @media (prefers-reduced-motion: no-preference) {
      /* For the folks who didn't opt in reduced motion */
      h1::after {
        animation: cursor-blink 1s step-start var(--delay) infinite backwards;
      }
    }
    .header-barcode {
      margin: 0.8rem 0 1.5rem 0.1rem;
      font-size: 2rem;
      font-family: var(--font-Barcode);
      letter-spacing: 3px;
    }
  }

  .heading.bordered {
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 800px) {
    .heading {
      padding: 100px var(--desktop-padding-inner) var(--desktop-padding-inner);
    }
  }

  @media (min-width: 1100px) {
    .heading {
      padding: 120px var(--desktop-padding-inner) var(--desktop-padding-inner);

      h1 {
        font-size: calc(2.2rem + 1vw);
      }

      h2 {
        font-size: calc(1.5rem + 0.5vw);
      }

      h1::after {
        font-size: calc(1.4rem + 1vw);
      }

      .header-barcode {
        font-size: calc(2rem + 1vw);
      }
    }
  }

  @keyframes cursor-blink {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
