---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import MissingSVG from "@assets/eboard/missing.svg";
import LinkedinSVG from "@assets/Linkedin.svg";
import GithubSVG from "@assets/Github.svg";
import WebSVG from "@assets/Web.svg";

/*
 * Tbh this component is quite ugly because the MD files itself
 * doesn't have the greatest structure.
 *
 * Like role/roles just shouldn't be a thing to begin with,
 * and stick to only roles.
 *
 * Also originally 3 separate components but I used AI to consolidate into 1.
 * Please forgive me ╮(︶︿︶)╭
 * */

interface Props {
  member:
    | CollectionEntry<"eBoard">
    | CollectionEntry<"formerEBoard">
    | CollectionEntry<"founders">;
}

const { member } = Astro.props;
const id = member.id;

let image;
let role;
let roles;
let linkedin;
let github;
let website;

const { name } = member.data;

switch (member.collection) {
  case "eBoard":
    ({ role, image, linkedin, github, website } = member.data);
    break;
  case "formerEBoard":
    ({ roles, linkedin, github, website } = member.data);
    break;
  case "founders":
    ({ role } = member.data);
    break;
}

const links = [];
if (linkedin)
  links.push({ label: "Linkedin", href: linkedin, Icon: LinkedinSVG });
if (github) links.push({ label: "Github", href: github, Icon: GithubSVG });
if (website) links.push({ label: "Website", href: website, Icon: WebSVG });
---

<article id={id}>
  {
    member.collection === "eBoard" &&
      (image ? (
        <Image
          class="member-img"
          src={image}
          alt={name}
          width={200}
          height={200}
        />
      ) : (
        <MissingSVG class="member-img" width={200} height={200} />
      ))
  }
  <div class="meta">
    <div class="meta-row">
      <p class="meta-label">// NAME //</p>
      <p class="meta-value meta-name">{name}</p>
    </div>
    {
      member.collection === "formerEBoard" ? (
        <div class="meta-row">
          <p class="meta-label">// ROLES //</p>
          {roles &&
            roles.map((r) => (
              <p class="meta-value">
                {r.role} ({r.yearsActive})
              </p>
            ))}
        </div>
      ) : (
        <div class="meta-row">
          <p class="meta-label">// ROLE //</p>
          <p class="meta-value">{role}</p>
        </div>
      )
    }
    {
      links.length > 0 && (
        <div class="meta-row">
          <p class="meta-label">// LINKS //</p>
          <p class="meta-value links">
            {links.map((link) => (
              <a href={link.href} aria-label={link.label}>
                <link.Icon class="link-icon" width={28} height={28} />
              </a>
            ))}
          </p>
        </div>
      )
    }
  </div>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    font-size: 1rem;
    line-height: 1.4;
    overflow-y: auto;
  }

  .member-img {
    width: 100%;
    height: auto;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 14px 16px;
  }

  .meta-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-label {
    font-family: var(--font-ZxProto);
    font-size: 0.72rem;
    letter-spacing: 0.5px;
    color: var(--color-white-3);
  }

  .meta-value {
    font-family: var(--font-Atkinson);
    font-size: 0.9rem;
    color: var(--color-papaya-white);
  }

  .meta-name {
    font-size: 1.3rem;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  .link-icon {
    display: block;
    color: var(--color-papaya-white);
  }
</style>
