---
import type { CollectionEntry } from "astro:content";
import { assertNever } from "@lib/fp";
import { Image } from "astro:assets";
import MissingSVG from "@assets/eboard/missing.svg";
import LinkedinSVG from "@assets/Linkedin.svg";
import GithubSVG from "@assets/Github.svg";
import WebSVG from "@assets/Web.svg";
import type { SvgComponent } from "astro/types";

type MemberType =
  | CollectionEntry<"eBoard">
  | CollectionEntry<"formerEBoard">
  | CollectionEntry<"founders">;

type MemberView = Readonly<{
  name: string;
  hasPhoto: boolean;
  /*
   * only current eBoard members have photos.
   *
   * This is pretty strict and may cause headache if people
   * wanted older members to have photos as well.
   *
   * Though I doubt that will happen at this point
   */
  image: CollectionEntry<"eBoard">["data"]["image"] | null;
  roles: readonly Readonly<{ role: string; yearsActive: string | null }>[];
  linkedin: string | null;
  github: string | null;
  website: string | null;
}>;

type LinkIcons = {
  linkedin: SvgComponent;
  github: SvgComponent;
  website: SvgComponent;
};

function memberView(member: MemberType): MemberView {
  const { name } = member.data;
  switch (member.collection) {
    case "eBoard": {
      const { role, image, linkedin, github, website } = member.data;
      return {
        name,
        hasPhoto: true,
        image: image ?? null,
        roles: [{ role, yearsActive: null }],
        linkedin: linkedin ?? null,
        github: github ?? null,
        website: website ?? null,
      };
    }
    case "formerEBoard": {
      const { roles, linkedin, github, website } = member.data;
      return {
        name,
        hasPhoto: false,
        image: null,
        roles,
        linkedin: linkedin ?? null,
        github: github ?? null,
        website: website ?? null,
      };
    }
    case "founders":
      return {
        name,
        hasPhoto: false,
        image: null,
        roles: [{ role: member.data.role, yearsActive: null }],
        linkedin: null,
        github: null,
        website: null,
      };
    default:
      return assertNever(member);
  }
}

function allLinks(view: MemberView, linkIcons: LinkIcons) {
  return [
    { label: "Linkedin", href: view.linkedin, Icon: linkIcons.linkedin },
    { label: "Github", href: view.github, Icon: linkIcons.github },
    { label: "Website", href: view.website, Icon: linkIcons.website },
  ].filter((link) => link.href != null);
}

const linkIcons = { linkedin: LinkedinSVG, github: GithubSVG, website: WebSVG };

interface Props {
  member: MemberType;
}

// lowk should rename the prop to chud
const { member } = Astro.props;
const view = memberView(member);
const { name, hasPhoto, image, roles } = view;
const links = allLinks(view, linkIcons);
---

<article id={member.id}>
  {
    hasPhoto &&
      (image ? (
        <Image
          class="member-img"
          src={image}
          alt={name}
          width={200}
          height={200}
        />
      ) : (
        <MissingSVG class="member-img" width={200} height={200} />
      ))
  }
  <div class="meta">
    <div class="meta-row">
      <p class="meta-label">// NAME //</p>
      <p class="meta-value meta-name">{name}</p>
    </div>
    <div class="meta-row">
      <p class="meta-label">// {roles.length > 1 ? "ROLES" : "ROLE"} //</p>
      {
        roles.map((r) => (
          <p class="meta-value">
            {r.role} {r.yearsActive}
          </p>
        ))
      }
    </div>
    {
      links.length > 0 && (
        <div class="meta-row">
          <p class="meta-label">// LINKS //</p>
          <p class="meta-value links">
            {links.map((link) => (
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={link.href}
                aria-label={link.label}
              >
                <link.Icon class="link-icon" width={28} height={28} />
              </a>
            ))}
          </p>
        </div>
      )
    }
  </div>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    font-size: 1rem;
    line-height: 1.4;
    overflow-y: auto;
  }

  .member-img {
    width: 100%;
    height: auto;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 14px 16px;
  }

  .meta-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .meta-label {
    font-family: var(--font-ZxProto);
    font-size: 0.72rem;
    letter-spacing: 0.5px;
    color: var(--color-white-3);
  }

  .meta-value {
    font-family: var(--font-Atkinson);
    font-size: 0.9rem;
    color: var(--color-papaya-white);
  }

  .meta-name {
    font-size: 1.3rem;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 12px;
  }

  .link-icon {
    display: block;
    color: var(--color-papaya-white);
  }
</style>
