---
interface Props {
  speed: number;
  content: string[];
}
const { speed = 20, content = [] } = Astro.props;
---

<marquee-slide class="marquee" data-speed={speed}>
  <div class="marquee-track">
    <div class="marquee-set">
      {content.map((quote) => <p class="marquee-text">{quote}</p>)}
    </div>
  </div>
</marquee-slide>

<script>
  import { animate, type JSAnimation, linear } from "animejs";
  import { assertExist } from "@lib/fp";

  // TODO: Need to seriously consider if using Web Components here was a good idea

  class MarqueeSlide extends HTMLElement {
    #animation!: JSAnimation;

    constructor() {
      super();
      this.addEventListener("mouseenter", () => this.#animation?.pause());
      this.addEventListener("mouseleave", () => this.#animation?.resume());
    }

    copyCount(strideWidth: number, windowWidth: number) {
      if (strideWidth <= 0) return 0;
      return Math.ceil((windowWidth * 2) / strideWidth);
    }

    connectedCallback() {
      const $track = this.querySelector(".marquee-track");
      assertExist($track, "$track does not exist");

      const $set = this.querySelector(".marquee-set");
      assertExist($set, "$set does not exist");

      const strideWidth = $set.getBoundingClientRect().width;
      const speed = Number(this.dataset.speed ?? 20);

      const n = this.copyCount(strideWidth, window.innerWidth);
      const clones = Array.from({ length: n }, () => $set.cloneNode(true));
      clones.forEach((clone) => $track.appendChild(clone));
      // console.log(clones);

      this.#animation = animate($track, {
        translateX: -strideWidth,
        duration: (strideWidth / speed) * 1000,
        delay: 300,
        loop: true,
        ease: linear(0, 1),
      });
    }

    disconnectedCallback() {
      this.#animation.cancel();
    }
  }

  customElements.define("marquee-slide", MarqueeSlide);
</script>

<style>
  marquee-slide {
    overflow: hidden;
    width: 100%;
    height: 60px;
    border-bottom: solid 1px var(--color-border);
    display: flex;
  }

  .marquee-track {
    display: flex;
    justify-content: start;
    text-align: center;

    .marquee-set {
      display: flex;
      align-items: center;
      padding-left: 40px;
      gap: 40px;
      height: 100%;
    }

    & :global(.marquee-text) {
      white-space: nowrap;
    }
    & :global(.marquee-text::before) {
      content: "/// ";
    }
    & :global(.marquee-text::after) {
      content: " ///";
    }
  }
</style>
