---
interface Props {
  speed: number;
  content: string[];
}
const { speed = 20, content = [] } = Astro.props;
---

<marquee-slide class="marquee" data-speed={speed}>
  <div class="marquee-track">
    <div class="marquee-set">
      {content.map((quote) => <p class="marquee-text">{quote}</p>)}
    </div>
  </div>
</marquee-slide>

<script>
  // TODO: Maybe need an resize observer to redo code inside connectedCallback()?
  import { animate, type JSAnimation, linear } from "animejs";
  import assertExist from "@lib/assertExist.ts";

  class MarqueeSlide extends HTMLElement {
    #animation!: JSAnimation;
    #track: HTMLDivElement | null = null;
    #set: HTMLDivElement | null = null;
    #SPEED = 0;

    constructor() {
      super();
      this.addEventListener("mouseenter", this.pauseAnimation);
      this.addEventListener("mouseleave", this.resumeAnimation);
    }

    copyCount() {
      assertExist(this.#set, "#set is null");
      const strideWidth = this.#set.getBoundingClientRect().width;
      return Math.ceil((window.innerWidth * 2) / strideWidth);
    }

    animateTrack() {
      assertExist(this.#set, "#set is null");
      assertExist(this.#track, "#track is null");
      const strideWidth = this.#set.getBoundingClientRect().width;
      // console.log(strideWidth);

      return animate(this.#track, {
        translateX: -strideWidth,
        duration: (strideWidth / this.#SPEED) * 1000,
        delay: 300,
        loop: true,
        ease: linear(0, 1),
      });
    }

    pauseAnimation() {
      this.#animation.pause();
    }

    resumeAnimation() {
      this.#animation.resume();
    }

    connectedCallback() {
      this.#track = this.querySelector(".marquee-track");
      this.#set = this.querySelector(".marquee-set");
      assertExist(this.#track, "#track does not exist");
      assertExist(this.#set, "$set does not exist");

      this.#SPEED = Number(this.dataset.speed ?? 20);

      for (let i = this.copyCount(); i > 0; i--) {
        const clone = this.#set.cloneNode(true);
        this.#track.appendChild(clone);
      }

      this.#animation = this.animateTrack();
    }

    disconnectedCallback() {
      this.#animation.cancel();
    }
  }

  customElements.define("marquee-slide", MarqueeSlide);
</script>

<style>
  marquee-slide {
    overflow: hidden;
    width: 100%;
    height: 60px;
    border-bottom: solid 1px var(--color-border);
    display: flex;
  }

  .marquee-track {
    display: flex;
    justify-content: start;
    text-align: center;

    .marquee-set {
      display: flex;
      align-items: center;
      padding-left: 40px;
      gap: 40px;
      height: 100%;
    }

    & :global(.marquee-text) {
      white-space: nowrap;
    }
    & :global(.marquee-text::before) {
      content: "/// ";
    }
    & :global(.marquee-text::after) {
      content: " ///";
    }
  }
</style>
