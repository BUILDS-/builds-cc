---
import EventCard from "@components/Event/EventCard.astro";
import { getCollection } from "astro:content";

const allEvents = (await getCollection("clubEvents")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section class="club-events grid-layout">
  {allEvents.map((event) => <EventCard id={event.id} event={event} />)}
</section>

<style>
  .club-events {
    position: relative;
  }

  .club-events[data-layout="grid"] {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 300px;
  }
</style>

<script>
  import assertExist from "@lib/assertExist";
  import { GAPDesktop } from "@lib/constants";
  import {
    createLayout,
    createDraggable,
    animate,
    utils,
    type DOMTargetSelector,
    Draggable,
  } from "animejs";

  const allDragable: Draggable[] = []; // Holds all draggable elements, used to disable them later

  /* --- START: Grid related functions --- */

  function initGrid($allCards: NodeListOf<HTMLDivElement>) {
    $allCards.forEach(($card) => {
      // Creates animatables and enables a little hover animation
      $card.addEventListener("mouseenter", () => cardMouseEnter($card));
      $card.addEventListener("mouseleave", () => cardMouseLeave($card));
    });
  }

  function cardMouseEnter($card: HTMLDivElement) {
    animate($card, {
      y: -20,
      margin: "0px",
      ease: "out(3)",
      duration: 100,
    });
  }

  function cardMouseLeave($card: HTMLDivElement) {
    animate($card, {
      y: 0,
      margin: "-1px",
      ease: "out(3)",
      duration: 100,
    });
  }

  /* --- END: Grid related functions --- */

  /* --- START: Draggable related functions --- */

  function initDraggables(
    $allCards: NodeListOf<HTMLDivElement>,
    $container: HTMLDivElement,
  ) {
    // animate($allCards, {
    //   scale: { from: 0 },
    //   delay: (_: Element, i: number) => i * 100,
    //   x: (_: Element, i: number) => i * 26 + 40,
    //   y: (_: Element, i: number) => i * 26 + 30,
    //   opacity: { from: 0.5 },
    //   duration: 100,
    //   onComplete: () => {},
    // });
    $allCards.forEach(($card) => {
      const $titleBar = $card.querySelector(".title-bar") as DOMTargetSelector;
      const draggable = createDraggable($card, {
        trigger: $titleBar,
        maxVelocity: 0,
        container: $container,
      });
      allDragable.push(draggable);
    });
  }

  function cleanDraggables() {
    allDragable.forEach(($draggable) => {
      $draggable.revert();
    });
    allDragable.length = 0; // clear array
  }

  /* --- END: Draggable related functions --- */

  function initEvents() {
    const $eventSection =
      document.querySelector<HTMLDivElement>(".club-events");
    assertExist($eventSection, "$eventSection does not exist");
    const eventSectionHeight = window.innerHeight - 4 * GAPDesktop;

    const $allCards = document.querySelectorAll<HTMLDivElement>(".event-card");
    assertExist($eventSection, "$eventSection does not exist");

    const layout = createLayout($eventSection);

    initGrid($allCards);
  }

  document.addEventListener("swup:page:view", (e) => {
    const swupEvent = e as CustomEvent;
    if (swupEvent.detail.visit.to.url === "/events") {
      initEvents();
    }
  });

  initEvents();
</script>
