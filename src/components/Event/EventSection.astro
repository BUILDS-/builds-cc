---
import EventCard from "@components/Event/EventCard.astro";
import Button from "@components/Button.astro";
import { getCollection } from "astro:content";

const allEvents = (await getCollection("clubEvents")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section class="event-section">
  <div class="controls">
    <p>// SWITCH LAYOUT //</p>
    <Button id="grid">Grid</Button>
    <Button id="drag">Draggable</Button>
    <br />
    <p>Add a scramble text here to show current layout</p>
  </div>
  <div class="club-events" data-layout="grid">
    {allEvents.map((event) => <EventCard id={event.id} event={event} />)}
  </div>
</section>

<style>
  .club-events {
    position: relative;
  }

  .club-events[data-layout="grid"] {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 300px;

    article {
      transform-origin: bottom center;
    }
  }

  .club-events[data-layout="drag"] {
    article {
      transform-origin: 0 0; /* Necessary to help card look like it renders in from top left*/
      position: absolute;
      width: 300px;
      height: 300px;
    }
  }

  .controls {
    padding: 20px var(--mobile-padding-inner);

    button {
      padding: 2px 5px;
      border: 2px solid;
    }

    button,
    p {
      display: inline-block;
    }
  }
</style>

<script>
  import assertExist from "@lib/assertExist";
  import { GAPDesktop } from "@lib/constants";
  import {
    createLayout,
    createDraggable,
    animate,
    utils,
    type DOMTargetSelector,
    Draggable,
  } from "animejs";

  const allDraggable: Draggable[] = []; // Holds all draggable elements, used to disable them later
  const $allCards = document.querySelectorAll<HTMLDivElement>(".event-card");

  /* --- START: Grid functions --- */

  function initGrid() {
    $allCards.forEach(($card) => {
      // Creates animatables and enables a little hover animation
      $card.addEventListener("mouseenter", () => cardMouseEnter($card));
      $card.addEventListener("mouseleave", () => cardMouseLeave($card));
    });
    animate($allCards, {
      y: { from: "50px" },
      opacity: { from: 0 },
      delay: utils.stagger(100),
      ease: "out(3)",
      duration: 400,
    });
  }

  function cardMouseEnter($card: HTMLDivElement) {
    animate($card, {
      y: -20,
      margin: "0px",
      ease: "out(3)",
      duration: 100,
    });
  }

  function cardMouseLeave($card: HTMLDivElement) {
    animate($card, {
      y: 0,
      margin: "-1px",
      ease: "out(3)",
      duration: 100,
    });
  }

  /* --- END: Grid functions --- */

  /* --- START: Draggable functions --- */

  function initDraggables($container: HTMLDivElement) {
    // animate($allCards, {
    //   scale: { from: 0 },
    //   delay: (_: Element, i: number) => i * 100,
    //   x: (_: Element, i: number) => i * 26 + 40,
    //   y: (_: Element, i: number) => i * 26 + 30,
    //   opacity: { from: 0.5 },
    //   duration: 100,
    //   onComplete: () => {},
    // });
    $allCards.forEach(($card) => {
      const $titleBar = $card.querySelector(".title-bar") as DOMTargetSelector;
      const draggable = createDraggable($card, {
        trigger: $titleBar,
        maxVelocity: 0,
        container: $container,
      });
      allDraggable.push(draggable);
    });
  }

  function cleanDraggables() {
    allDraggable.forEach(($draggable) => {
      $draggable.revert();
    });
    allDraggable.length = 0; // clear array
  }

  /* --- END: Draggable functions --- */

  function initControls($clubEventsDiv: HTMLDivElement) {
    const $controlsDiv = document.querySelector(".controls");
    assertExist($controlsDiv, "$controlsDiv does not exist");
    assertExist($clubEventsDiv, "$clubEventsDiv does not exist");

    $controlsDiv.addEventListener("click", (e) => {
      const $target = e.target as HTMLElement;
      assertExist($target, "$target does not exist");
      const $button = $target.closest("button");

      if ($button != null) {
        switch ($button.id) {
          case "grid":
            $clubEventsDiv.dataset.layout = "grid";
            break;
          case "drag":
            $clubEventsDiv.dataset.layout = "drag";
            break;
          default:
            console.log("Unreachable state");
            break;
        }
      }
    });
  }

  /* --- Page initialization --- */
  function initEvents() {
    const $clubEventsDiv =
      document.querySelector<HTMLDivElement>(".club-events");
    assertExist($clubEventsDiv, "$clubEventsDiv does not exist");

    const eventDivHeight = window.innerHeight - 4 * GAPDesktop;
    $clubEventsDiv.style.height = `${eventDivHeight + 500}px`;

    assertExist($clubEventsDiv, "$clubEventsDiv does not exist");

    initGrid();
    initControls($clubEventsDiv);
  }

  document.addEventListener("swup:page:view", (e) => {
    const swupEvent = e as CustomEvent;
    if (swupEvent.detail.visit.to.url === "/events") {
      initEvents();
    }
  });

  initEvents();
</script>
