---
import EventCard from "@components/Event/EventCard.astro";
import { getCollection } from "astro:content";

const allEvents = (await getCollection("clubEvents")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
); // Sorts event from newest -> oldest

// For the sake of load speed AND the performance of this page use small image sizes for events PLS
---

<section class="event-section">
  <div class="controls">
    <p>// SWITCH LAYOUT //</p>
    <div class="layout-switch">
      <button id="grid">
        <span class="switch-text">Grid</span>
        <span class="switch-highlight"></span>
      </button>
      <button id="drag">
        <span class="switch-text">Draggable</span>
      </button>
    </div>
  </div>
  <div class="club-events" data-layout="grid">
    {allEvents.map((event) => <EventCard id={event.id} event={event} />)}
  </div>
</section>

<style>
  .controls {
    opacity: 0;
    visibility: hidden;

    display: flex;
    align-items: center;
    gap: 15px;
    padding: 20px var(--mobile-padding-inner);
    @media (min-width: 800px) {
      padding: 20px var(--desktop-padding-inner);
    }

    p {
      margin: 0;
    }
  }

  .layout-switch {
    position: relative;
    display: flex;
    align-items: center;

    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .layout-switch button {
    position: relative;
    display: inline-block;
    padding: 3px 10px;
    border: none;
    background: transparent;
    cursor: pointer;

    font-family: var(--font-Atkinson);
    font-size: 1rem;
  }

  .switch-text {
    position: relative;
    z-index: 2;
  }

  .layout-switch button:has(.switch-highlight) {
    color: var(--color-text);
  }

  .switch-highlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 2px;
    z-index: 1;
    background-color: var(--color-bg);
  }

  .club-events {
    position: relative;
  }

  .club-events[data-layout="grid"] {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(325px, 1fr));
    grid-auto-rows: 300px;

    article {
      transform-origin: bottom center;
      opacity: 0;
    }
  }

  .club-events[data-layout="drag"] {
    article {
      transform-origin: 0 0;
      position: absolute;
      width: 350px;
      height: 350px;
      top: 0;
      left: 30px;
    }
  }

  /* The dialog is created at runtime via document.createElement, so it does not
     carry Astro's scoped data-cid attribute. All #layout-dialog rules 
     must be :global to actually match it. */
  :global(#layout-dialog) {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    z-index: var(--z-modal);
    top: 0;
    left: 0;
    width: 100svw;
    height: 100svh;
    max-width: 100%;
    max-height: 100%;
    border: none;
    background: transparent;
    pointer-events: none;

    --overlay-alpha: 100%;

    /* julian sir... what is color-mix? */
    background-color: color-mix(
      in srgb,
      var(--color-black-1),
      transparent var(--overlay-alpha)
    );
  }
  :global(#layout-dialog)::backdrop {
    background: transparent;
  }

  :global(#layout-dialog[open]) {
    --overlay-alpha: 40%;
    pointer-events: auto;
  }

  :global(.event-card.is-open) {
    visibility: hidden;
  }
  :global(#layout-dialog .event-card) {
    visibility: hidden;
  }
  :global(#layout-dialog[open] .event-card) {
    visibility: visible;
  }
</style>

<script>
  import setup from "@scripts/events/setup";

  document.addEventListener("swup:page:view", (e) => {
    const swupEvent = e as CustomEvent;
    const toUrl = swupEvent.detail.visit.to.url;
    // console.log(toUrl);
    if (toUrl === "/events/") {
      setup();
    }
  });

  setup();
</script>
