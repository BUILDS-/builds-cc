---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
interface Props {
  id: string;
  event: CollectionEntry<"clubEvents">;
}

const { id, event } = Astro.props;
---

<article id={id} class="event-card">
  <div class="window-title"></div>
  <Image draggable="false" alt="Test" src={event.data.image} />
</article>

<style>
  article {
    border: 1px solid var(--color-border);
    margin: -1px; /* To combat overlapping border*/
    background-color: black;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
