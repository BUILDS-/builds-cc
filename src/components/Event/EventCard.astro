---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
interface Props {
  id: string;
  event: CollectionEntry<"clubEvents">;
}

const { id, event } = Astro.props;

const { title, description, location, instructors, badges, link, linkText } =
  event.data;

const date = event.data.date;
const day = date
  // turns date into YYYY/MM/DAY format
  .toISOString()
  .replace("-", "/")
  .split("T")[0]
  .replace("-", "/");

const time = date.toLocaleTimeString("en-us", { timeStyle: "short" });

// The `emoji` field is a plain string: sometimes a real emoji glyph, sometimes
// an asset path (e.g. "../../assets/.../foo.svg"). Path values aren't run
// through Astro's image pipeline, so we render the label only for those and
// avoid a broken glyph. A real emoji glyph won't contain a slash or extension.
const isPathLike = (s: string) => /[\\/]|\.(svg|png|jpe?g|webp|gif)$/i.test(s);
---

<article id={id} class="event-card">
  <div class="title-bar">
    <p class="window-title">{title}</p>
    <p>{day}</p>
  </div>
  <Image priority draggable="false" alt={title} src={event.data.image} />
  <div class="dialog-info-wrapper">
    <div class="dialog-meta">
      <div class="meta-row">
        <p class="meta-label">// DATE //</p>
        <p class="meta-value">{`${day} @ ${time}`}</p>
      </div>
      <div class="meta-row">
        <p class="meta-label">// LOCATION //</p>
        <p class="meta-value">{location}</p>
      </div>
    </div>

    {
      badges.length > 0 && (
        <ul class="dialog-badges">
          {badges.map((badge) => (
            <li class="badge">
              {!isPathLike(badge.emoji) && (
                <span class="badge-emoji">{badge.emoji}</span>
              )}
              <span class="badge-label">{badge.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    <p class="dialog-description">{description}</p>

    {
      instructors.length > 0 && (
        <div class="dialog-instructors">
          <p class="meta-label">// INSTRUCTORS //</p>
          <ul class="lead-list">
            {instructors.map((person) => (
              <li class="lead">
                {person.image && (
                  <Image
                    class="lead-avatar"
                    draggable="false"
                    alt={person.name}
                    src={person.image}
                    width={32}
                    height={32}
                  />
                )}
                <span class="lead-name">{person.name}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      link && (
        <a class="dialog-btn" href={link} target="_blank" rel="noreferrer">
          {linkText ?? "Learn More"}
        </a>
      )
    }
  </div>
</article>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    background-color: black;
  }
  .title-bar {
    position: relative;
    min-height: 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    /* cursor: grab; */

    font-size: 0.9rem;
    padding: 0px 10px;
  }

  img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    overflow: hidden; /* Somehow instead of clipping, forces the image to fit? */
    cursor: pointer;
  }

  .dialog-info-wrapper {
    display: none;
  }

  /* These live inside .dialog-info-wrapper (hidden in grid view) and are only
     revealed inside #layout-dialog. Grid view never renders them, but scoping
     the reset here keeps the cascade predictable. */
  .dialog-badges,
  .lead-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(#layout-dialog .event-card) {
    display: flex;
    flex-direction: column;
    width: 500px;
    max-height: 85dvh;
    overflow: hidden;
    cursor: default;
    border: 1px solid var(--color-border);
    background-color: var(--color-black-1);
    color: var(--color-papaya-white);
  }

  :global(#layout-dialog .event-card .title-bar) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 25px;
    padding: 0 10px;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }

  :global(#layout-dialog .event-card img) {
    width: 100%;
    height: 100%;
    max-height: 350px;
    display: block;
    object-fit: contain;
    flex: 0 0 auto;
    display: block;
    cursor: default;
    border-bottom: 1px solid var(--color-border);
  }

  :global(#layout-dialog .event-card .dialog-info-wrapper) {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 14px 14px 16px;
    font-size: 1rem;
    line-height: 1.4;
    overflow-y: auto;

    opacity: 0;
    transition: opacity 200ms ease-out;
  }

  :global(#layout-dialog[open] .event-card .dialog-info-wrapper) {
    opacity: 1;
    transition: opacity 250ms ease-out 150ms;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(#layout-dialog .event-card .dialog-info-wrapper),
    :global(#layout-dialog[open] .event-card .dialog-info-wrapper) {
      transition: none;
    }
  }

  :global(#layout-dialog .event-card .meta-label) {
    font-family: var(--font-ZxProto);
    font-size: 0.72rem;
    letter-spacing: 0.5px;
    color: var(--color-white-3);
  }

  /* --- Metadata rows (date / location) --- */
  :global(#layout-dialog .event-card .dialog-meta) {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  :global(#layout-dialog .event-card .meta-row) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  :global(#layout-dialog .event-card .meta-value) {
    font-family: var(--font-ZxProto);
    font-size: 0.9rem;
    color: var(--color-papaya-white);
  }

  /* --- Badges --- */
  :global(#layout-dialog .event-card .dialog-badges) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  :global(#layout-dialog .event-card .badge) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    font-family: var(--font-ZxProto);
    font-size: 0.78rem;
    line-height: 1.6;
  }
  :global(#layout-dialog .event-card .badge-emoji) {
    font-family: var(--font-Atkinson);
  }

  /* --- Description --- */
  :global(#layout-dialog .event-card .dialog-description) {
    font-family: var(--font-Atkinson);
  }

  /* --- Instructors --- */
  :global(#layout-dialog .event-card .dialog-instructors) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(#layout-dialog .event-card .lead-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
  }
  :global(#layout-dialog .event-card .lead) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  :global(#layout-dialog .event-card .lead-avatar) {
    width: 32px;
    height: 32px;
    object-fit: cover;
    border: 1px solid var(--color-border);
    display: block;
  }
  :global(#layout-dialog .event-card .lead-name) {
    font-family: var(--font-ZxProto);
    font-size: 0.85rem;
  }

  /* --- Button styling here re-uses styling from Button.astro --- */
  :global(#layout-dialog .event-card .dialog-btn) {
    align-self: flex-start;
    margin-top: 2px;
    border: 3px solid var(--color-papaya-white);
    background-color: var(--color-papaya-white);
    color: black;
    padding: 3px 15px;
    text-decoration: none;
    font-family: var(--font-Atkinson);
    font-size: 1rem;
    cursor: pointer;
    transition:
      border-color 100ms,
      color 100ms,
      transform 100ms;
  }
  @media (hover: hover) {
    :global(#layout-dialog .event-card .dialog-btn:hover) {
      border-color: var(--color-accent);
      color: var(--color-accent);
      transform: translateX(3px) translateY(-3px);
      transition:
        border-color 170ms,
        color 170ms,
        transform 170ms;
    }
  }
  :global(#layout-dialog .event-card .dialog-btn:active) {
    border-color: var(--color-accent);
    transform: translateX(-2px) translateY(2px);
    transition:
      border-color 100ms,
      transform 100ms;
  }

  .noselect {
    -webkit-touch-callout: none; /* iOS Safari */
    -webkit-user-select: none; /* Safari */
    -khtml-user-select: none; /* Konqueror HTML */
    -moz-user-select: none; /* Old versions of Firefox */
    -ms-user-select: none; /* Internet Explorer/Edge */
    user-select: none;
  }
</style>
