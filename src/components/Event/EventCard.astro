---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
interface Props {
  id: string;
  event: CollectionEntry<"clubEvents">;
}

const { id, event } = Astro.props;
---

<article
  id={id}
  class="event-card"
  style=`--width:${event.data.image.width}; --height:${event.data.image.height};`
>
  <div class="window-title"></div>
  <Image draggable="false" alt="Test" src={event.data.image} />
</article>

<style>
  article {
    position: absolute;
    border: 1px solid var(--color-border);
    background-color: black;
    width: 300px;
    height: 300px;
    aspect-ratio: var(--width) / var(--height);
    transform-origin: 0 0;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
