---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CloseSVG from "@assets/close.svg";
interface Props {
  id: string;
  event: CollectionEntry<"clubEvents">;
}

const { id, event } = Astro.props;
---

<article id={id} class="event-card">
  <div class="title-bar noselect">
    <p class="event-title">{event.data.title}</p>
    <CloseSVG />
  </div>
  <Image priority draggable="false" alt="Test" src={event.data.image} />
</article>

<style>
  article {
    position: absolute;
    width: 300px;
    height: 300px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    background-color: black;
    transform-origin: 0 0; /* Necessary to help card look like it renders in from top left*/
  }
  .title-bar {
    position: relative;
    min-height: 25px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    cursor: grab;

    p {
      font-size: 0.9rem;
    }

    svg {
      position: absolute;
      height: 25px;
      width: 25px;
      color: white;
      border-left: 1px solid var(--color-border);
      right: 0;
    }
  }
  img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    overflow: hidden; /* Somehow instead of clipping, forces the image to fit? */
    cursor: pointer;
  }

  .noselect {
    -webkit-touch-callout: none; /* iOS Safari */
    -webkit-user-select: none; /* Safari */
    -khtml-user-select: none; /* Konqueror HTML */
    -moz-user-select: none; /* Old versions of Firefox */
    -ms-user-select: none; /* Internet Explorer/Edge */
    user-select: none;
  }
</style>
